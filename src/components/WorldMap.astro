---
// src/components/WorldMap.astro
import { WORLD_REGIONS } from "./GurmukhiData";
---
<div class="w-full bg-canvas-dark relative select-none overflow-hidden py-12 px-4 md:px-8 border-b border-hairline-dark">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-8 text-center md:text-left flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <p class="caption-sm text-primary uppercase font-bold tracking-widest">Campaign Mode</p>
        <h1 class="display-lg text-on-dark mt-1">World Journey Map</h1>
        <p class="body-sm text-on-dark-mute mt-2 max-w-xl">
          Travel across Punjabi diaspora hubs. Complete lessons to unlock new regions, earn unique cultural relics, and claim regional trophies.
        </p>
      </div>
      <div class="bg-surface-dark-card border border-hairline-dark p-4 rounded-md flex gap-6 text-center shadow-md justify-center">
        <div>
          <span class="text-xs text-on-dark-mute uppercase tracking-wider block">Regions Unlocked</span>
          <span id="map-stats-unlocked" class="text-xl font-display font-light text-primary">1 / 7</span>
        </div>
        <div class="border-l border-hairline-dark"></div>
        <div>
          <span class="text-xs text-on-dark-mute uppercase tracking-wider block">Total Progress</span>
          <span id="map-stats-progress" class="text-xl font-display font-light text-green-400">0%</span>
        </div>
      </div>
    </div>

    <!-- Map Board -->
    <div class="w-full bg-surface-dark-elevated rounded-md border border-hairline-dark overflow-hidden relative shadow-2xl" style="min-height: 480px;">
      <!-- Stars/Nebula Background grid -->
      <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#0070d1_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
      
      <!-- Interactive SVG Layer for paths and node vectors -->
      <svg class="absolute inset-0 w-full h-full min-h-[480px] pointer-events-auto" viewBox="0 0 1000 500" preserveAspectRatio="xMidYMid slice" id="journey-svg">
        <!-- SVG Filters for glowing paths -->
        <defs>
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="5" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- Travel Path Connections -->
        <!-- India to Pakistan -->
        <path d="M 640 270 Q 590 250 540 240" fill="none" stroke="#1f2024" stroke-width="4" id="path-india-pakistan" class="map-path transition-all duration-1000" />
        <!-- Pakistan to Canada -->
        <path d="M 540 240 Q 380 140 220 160" fill="none" stroke="#1f2024" stroke-width="4" stroke-dasharray="8,8" id="path-pakistan-canada" class="map-path transition-all duration-1000" />
        <!-- Canada to UK -->
        <path d="M 220 160 Q 340 120 460 140" fill="none" stroke="#1f2024" stroke-width="4" stroke-dasharray="8,8" id="path-canada-uk" class="map-path transition-all duration-1000" />
        <!-- UK to US -->
        <path d="M 460 140 Q 320 200 180 230" fill="none" stroke="#1f2024" stroke-width="4" stroke-dasharray="8,8" id="path-uk-us" class="map-path transition-all duration-1000" />
        <!-- US to Australia -->
        <path d="M 180 230 Q 500 450 820 400" fill="none" stroke="#1f2024" stroke-width="4" stroke-dasharray="8,8" id="path-us-australia" class="map-path transition-all duration-1000" />
        <!-- Australia to Global -->
        <path d="M 820 400 Q 680 380 540 330" fill="none" stroke="#1f2024" stroke-width="4" stroke-dasharray="8,8" id="path-australia-global" class="map-path transition-all duration-1000" />
      </svg>

      <!-- Landmark Visual Overlays and Country Node Targets -->
      <!-- India (Punjab) -->
      <div class="absolute map-node" style="left: 64%; top: 54%;" data-region="india">
        <div class="node-landmark select-none pointer-events-none absolute -top-12 -left-12 w-24 text-center">
          <span class="text-3xl block filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">🕌</span>
          <span class="text-[9px] uppercase tracking-widest text-on-dark-mute bg-canvas-dark/80 px-1 rounded">Amritsar</span>
        </div>
        <button class="node-button w-8 h-8 rounded-full border-2 border-primary bg-primary flex items-center justify-center font-bold text-xs shadow-lg transition-transform hover:scale-125 focus:outline-none" aria-label="Punjab, India">
          🇮🇳
        </button>
      </div>

      <!-- Pakistan (Punjab) -->
      <div class="absolute map-node" style="left: 54%; top: 48%;" data-region="pakistan">
        <div class="node-landmark select-none pointer-events-none absolute -top-12 -left-12 w-24 text-center">
          <span class="text-3xl block filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">🕍</span>
          <span class="text-[9px] uppercase tracking-widest text-on-dark-mute bg-canvas-dark/80 px-1 rounded">Lahore</span>
        </div>
        <button class="node-button w-8 h-8 rounded-full border-2 border-charcoal bg-surface-dark-card flex items-center justify-center font-bold text-xs shadow-lg opacity-60 transition-transform hover:scale-125 focus:outline-none" aria-label="Punjab, Pakistan" disabled>
          🇵🇰
        </button>
      </div>

      <!-- Canada -->
      <div class="absolute map-node" style="left: 22%; top: 32%;" data-region="canada">
        <div class="node-landmark select-none pointer-events-none absolute -top-12 -left-12 w-24 text-center">
          <span class="text-3xl block filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">🏢</span>
          <span class="text-[9px] uppercase tracking-widest text-on-dark-mute bg-canvas-dark/80 px-1 rounded">Surrey</span>
        </div>
        <button class="node-button w-8 h-8 rounded-full border-2 border-charcoal bg-surface-dark-card flex items-center justify-center font-bold text-xs shadow-lg opacity-60 transition-transform hover:scale-125 focus:outline-none" aria-label="Canada" disabled>
          🇨🇦
        </button>
      </div>

      <!-- United Kingdom -->
      <div class="absolute map-node" style="left: 46%; top: 28%;" data-region="uk">
        <div class="node-landmark select-none pointer-events-none absolute -top-12 -left-12 w-24 text-center">
          <span class="text-3xl block filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">🎡</span>
          <span class="text-[9px] uppercase tracking-widest text-on-dark-mute bg-canvas-dark/80 px-1 rounded">Southall</span>
        </div>
        <button class="node-button w-8 h-8 rounded-full border-2 border-charcoal bg-surface-dark-card flex items-center justify-center font-bold text-xs shadow-lg opacity-60 transition-transform hover:scale-125 focus:outline-none" aria-label="United Kingdom" disabled>
          🇬🇧
        </button>
      </div>

      <!-- United States -->
      <div class="absolute map-node" style="left: 18%; top: 46%;" data-region="us">
        <div class="node-landmark select-none pointer-events-none absolute -top-12 -left-12 w-24 text-center">
          <span class="text-3xl block filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">🚜</span>
          <span class="text-[9px] uppercase tracking-widest text-on-dark-mute bg-canvas-dark/80 px-1 rounded">Yuba City</span>
        </div>
        <button class="node-button w-8 h-8 rounded-full border-2 border-charcoal bg-surface-dark-card flex items-center justify-center font-bold text-xs shadow-lg opacity-60 transition-transform hover:scale-125 focus:outline-none" aria-label="United States" disabled>
          🇺🇸
        </button>
      </div>

      <!-- Australia -->
      <div class="absolute map-node" style="left: 82%; top: 80%;" data-region="australia">
        <div class="node-landmark select-none pointer-events-none absolute -top-12 -left-12 w-24 text-center">
          <span class="text-3xl block filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">⛵</span>
          <span class="text-[9px] uppercase tracking-widest text-on-dark-mute bg-canvas-dark/80 px-1 rounded">Woolgoolga</span>
        </div>
        <button class="node-button w-8 h-8 rounded-full border-2 border-charcoal bg-surface-dark-card flex items-center justify-center font-bold text-xs shadow-lg opacity-60 transition-transform hover:scale-125 focus:outline-none" aria-label="Australia" disabled>
          🇦🇺
        </button>
      </div>

      <!-- Global Master Region -->
      <div class="absolute map-node" style="left: 54%; top: 66%;" data-region="global">
        <div class="node-landmark select-none pointer-events-none absolute -top-12 -left-12 w-24 text-center">
          <span class="text-3xl block filter drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">👑</span>
          <span class="text-[9px] uppercase tracking-widest text-on-dark-mute bg-canvas-dark/80 px-1 rounded">Global Master</span>
        </div>
        <button class="node-button w-8 h-8 rounded-full border-2 border-charcoal bg-surface-dark-card flex items-center justify-center font-bold text-xs shadow-lg opacity-60 transition-transform hover:scale-125 focus:outline-none" aria-label="Global Punjabi Master" disabled>
          🌐
        </button>
      </div>

      <!-- Detail Card Modal Layer (PlayStation Style Card Overlay) -->
      <div id="map-detail-card" class="absolute bottom-4 left-4 right-4 md:left-auto md:right-4 md:w-80 bg-surface-dark-card border border-hairline-dark rounded-md p-5 shadow-2xl opacity-0 translate-y-4 pointer-events-none transition-all duration-300 z-10">
        <div class="flex items-center justify-between mb-2">
          <span id="detail-flag" class="text-2xl">🇮🇳</span>
          <span id="detail-unlocked-status" class="caption-sm bg-primary/20 text-primary border border-primary/40 px-2 py-0.5 rounded-full font-bold">UNLOCKED</span>
        </div>
        <h3 id="detail-title" class="heading-lg text-on-dark">Punjab, India</h3>
        <p id="detail-subtitle" class="caption-md text-on-dark-mute mt-1 italic">The Homeland of Gurmukhi</p>
        
        <div class="border-t border-hairline-dark my-3"></div>

        <div class="space-y-2">
          <h4 class="text-[11px] uppercase tracking-wider text-on-dark-mute font-bold">Region Focus:</h4>
          <ul id="detail-focus-list" class="text-xs text-on-dark space-y-1 pl-4 list-disc">
            <li>Introduction to Gurmukhi script</li>
            <li>Alphabet letters ੳ to ਹ</li>
          </ul>
        </div>

        <div class="border-t border-hairline-dark my-3"></div>

        <div class="grid grid-cols-2 gap-2 mb-4">
          <div class="bg-surface-dark-elevated p-2 rounded text-center border border-hairline-dark">
            <span class="text-[9px] uppercase tracking-wider text-on-dark-mute block">Trophy reward</span>
            <span id="detail-trophy-name" class="text-xs font-semibold text-yellow-400 mt-1 block">🏆 Beginner</span>
          </div>
          <div class="bg-surface-dark-elevated p-2 rounded text-center border border-hairline-dark">
            <span class="text-[9px] uppercase tracking-wider text-on-dark-mute block">Pendant Relic</span>
            <span id="detail-pendant-name" class="text-xs font-semibold text-blue-400 mt-1 block">💎 Heritage</span>
          </div>
        </div>

        <!-- PlayStation Pill CTA -->
        <button id="detail-cta-btn" class="w-full py-2.5 rounded-full bg-primary hover:bg-primary-pressed text-white font-bold text-sm tracking-wider shadow-lg transition-colors flex items-center justify-center gap-2">
          START CHAPTER
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .map-node {
    transform: translate(-50%, -50%);
  }
  .node-button {
    cursor: pointer;
  }
  .node-button:not([disabled]) {
    animation: pulse-glow 2.5s infinite;
  }
  
  @keyframes pulse-glow {
    0% {
      box-shadow: 0 0 0 0 rgba(0, 112, 209, 0.7);
    }
    70% {
      box-shadow: 0 0 0 12px rgba(0, 112, 209, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 112, 209, 0);
    }
  }

  .node-button.active-node {
    border-color: #deff20 !important; /* PlayStation Marathon Accent Yellow */
    box-shadow: 0 0 20px #deff20 !important;
  }
</style>
