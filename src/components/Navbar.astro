---
// src/components/Navbar.astro
---
<header class="w-full select-none z-50 sticky top-0">
  <!-- Primary Navigation (48px) -->
  <nav class="h-12 bg-canvas-dark text-on-dark flex items-center justify-between px-4 border-b border-hairline-dark">
    <!-- Left Logo -->
    <div class="flex items-center gap-3 cursor-pointer" id="nav-logo-btn">
      <!-- Custom Punjabi Adventure PlayStation-style Logo -->
      <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center font-bold text-lg tracking-wider text-white shadow-md">
        ਪ
      </div>
      <span class="font-display font-light text-lg tracking-widest hidden md:inline uppercase">
        Punjabi <span class="text-primary font-medium">Adventure</span>
      </span>
    </div>

    <!-- Center Navigation Links -->
    <div class="flex items-center gap-1 md:gap-4 font-body font-medium text-sm md:text-base">
      <button 
        data-nav-target="MAP" 
        class="nav-tab px-3 py-1.5 rounded-full hover:text-primary transition-all duration-300 text-on-dark"
      >
        Map
      </button>
      <button 
        data-nav-target="LEARN" 
        class="nav-tab px-3 py-1.5 rounded-full hover:text-primary transition-all duration-300 text-on-dark-mute"
      >
        Letters & Numbers
      </button>
      <button 
        data-nav-target="MUSEUM" 
        class="nav-tab px-3 py-1.5 rounded-full hover:text-primary transition-all duration-300 text-on-dark-mute"
      >
        Trophy Room
      </button>
      <button 
        data-nav-target="CULTURE" 
        class="nav-tab px-3 py-1.5 rounded-full hover:text-primary transition-all duration-300 text-on-dark-mute"
      >
        Culture
      </button>
      <button 
        data-nav-target="STATS" 
        class="nav-tab px-3 py-1.5 rounded-full hover:text-primary transition-all duration-300 text-on-dark-mute"
      >
        Stats
      </button>
    </div>

    <!-- Right Side Stats Cluster -->
    <div class="flex items-center gap-3 text-xs md:text-sm">
      <!-- Streak Flame -->
      <div class="flex items-center gap-1 bg-surface-dark-card border border-hairline-dark px-2.5 py-1 rounded-full text-orange-500 font-semibold" title="Daily Streak">
        <span>🔥</span>
        <span id="nav-streak-val">0</span>d
      </div>

      <!-- Coins -->
      <div class="flex items-center gap-1 bg-surface-dark-card border border-hairline-dark px-2.5 py-1 rounded-full text-yellow-400 font-semibold" title="Coins Collected">
        <span>🪙</span>
        <span id="nav-coins-val">0</span>
      </div>

      <!-- Level -->
      <div class="bg-primary hover:bg-primary-pressed text-white font-bold px-3 py-1 rounded-full text-xs shadow-inner cursor-pointer" id="nav-level-badge">
        Lv. <span id="nav-level-val">1</span>
      </div>
      
      <!-- Audio Mute Button -->
      <button id="nav-mute-btn" class="w-8 h-8 rounded-full bg-surface-dark-card border border-hairline-dark flex items-center justify-center text-sm cursor-pointer hover:bg-charcoal" title="Toggle Sound">
        🔊
      </button>
    </div>
  </nav>

  <!-- Sub Navigation Progress Bar (40px) -->
  <div class="h-10 bg-surface-dark-elevated text-on-dark-mute flex items-center justify-between px-4 border-b border-hairline-dark text-xs md:text-sm">
    <div class="flex items-center gap-2">
      <span class="text-on-dark-mute">Journey Progress:</span>
      <div class="w-24 md:w-48 bg-charcoal h-2.5 rounded-full overflow-hidden border border-hairline-dark">
        <div id="nav-progress-fill" class="bg-primary h-full transition-all duration-500" style="width: 0%;"></div>
      </div>
      <span id="nav-progress-text" class="font-bold text-on-dark">0%</span>
    </div>
    
    <div class="flex items-center gap-2">
      <span class="text-on-dark-mute">Current Rank:</span>
      <span id="nav-rank-val" class="font-semibold text-primary">Beginner Scholar</span>
    </div>
  </div>
</header>

<style>
  /* PlayStation Tab styling overrides */
  .nav-tab {
    cursor: pointer;
  }
  .nav-tab.active {
    color: var(--color-on-dark);
    background-color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(0, 112, 209, 0.4);
  }
</style>
