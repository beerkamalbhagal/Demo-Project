  // Stats UI update dial percentages
  function updateStatsUI() {
    const totalXpEl = document.getElementById("stats-xp-ratio");
    const xpFillEl = document.getElementById("stats-xp-fill");
    const levelEl = document.getElementById("stats-level-val");
    const accuracyEl = document.getElementById("stats-accuracy-val");
    const streakEl = document.getElementById("stats-streak-val");
    const longStreakEl = document.getElementById("stats-longest-streak-val");
    const lessonsEl = document.getElementById("stats-lessons-val");
    const trophiesEl = document.getElementById("stats-trophies-val");
    const medalsEl = document.getElementById("stats-medals-val");
    const pendantsEl = document.getElementById("stats-pendants-val");
    
    const dialVal = document.getElementById("stats-mastery-val");
    const dialRing = document.getElementById("mastery-circle-fill");

    if (!totalXpEl || !xpFillEl || !levelEl || !accuracyEl || !streakEl || !longStreakEl || !lessonsEl || !trophiesEl || !medalsEl || !pendantsEl) return;

    levelEl.textContent = state.level.toString();
    
    // Level XP math (levels are 100 XP increments)
    const levelBase = (state.level - 1) * 150;
    const currentLvlXp = state.xp - levelBase;
    const nextLvlThreshold = 150;
    const xpPercent = Math.min(100, Math.round((currentLvlXp / nextLvlThreshold) * 100));

    totalXpEl.textContent = `${currentLvlXp} / ${nextLvlThreshold} XP (Total: ${state.xp} XP)`;
    xpFillEl.style.width = `${xpPercent}%`;

    // Accuracy calculations
    let avgAccuracy = 100;
    if (state.earnedMedals.length > 0) {
      const sum = state.earnedMedals.reduce((acc, m) => acc + m.accuracy, 0);
      avgAccuracy = Math.round(sum / state.earnedMedals.length);
    }
    accuracyEl.textContent = `${avgAccuracy}%`;

    streakEl.textContent = state.streak.toString();
    longStreakEl.textContent = state.longestStreak.toString();
    
    // Count lessons cleared
    let lessonsCleared = 0;
    Object.keys(state.completedLessons).forEach(k => {
      lessonsCleared += state.completedLessons[k];
    });
    lessonsEl.textContent = lessonsCleared.toString();

    trophiesEl.textContent = state.earnedTrophies.length.toString();
    medalsEl.textContent = state.earnedMedals.length.toString();
    pendantsEl.textContent = state.unlockedPendants.length.toString();

    // Mastery Dial
    const maxLetters = GURMUKHI_ALPHABET.length;
    const distinctLessonsTraced = state.lettersTracedToday || 0; 
    const masteryPercent = Math.min(100, Math.round((lessonsCleared / 25) * 100)); // 25 total lessons in campaign
    
    if (dialVal) dialVal.textContent = `${masteryPercent}%`;
    if (dialRing) {
      // Stroke dashoffset: circumference of r=60 is 377
      const offset = 377 - (377 * masteryPercent) / 100;
      dialRing.setAttribute("stroke-dashoffset", offset.toString());
    }

    // Update Challenges list checkboxes & labels
    const ch1 = document.getElementById("daily-ch-1") as HTMLInputElement;
    const ch1Txt = document.getElementById("daily-ch-1-text");
    const ch2 = document.getElementById("daily-ch-2") as HTMLInputElement;
    const ch2Txt = document.getElementById("daily-ch-2-text");
    const ch3 = document.getElementById("daily-ch-3") as HTMLInputElement;
    const ch3Txt = document.getElementById("daily-ch-3-text");

    const wch1 = document.getElementById("weekly-ch-1") as HTMLInputElement;
    const wch1Txt = document.getElementById("weekly-ch-1-text");
    const wch2 = document.getElementById("weekly-ch-2") as HTMLInputElement;
    const wch2Txt = document.getElementById("weekly-ch-2-text");

    // Daily 1: Practice letter
    const lettersTraced = state.lettersTracedToday;
    if (ch1) ch1.checked = lettersTraced >= 1;
    if (ch1Txt) ch1Txt.textContent = `Practice tracing 1 letter (${lettersTraced}/1)`;

    // Daily 2: Earn coins today
    const coinsEarned = state.coinsEarnedToday;
    if (ch2) ch2.checked = coinsEarned >= 20;
    if (ch2Txt) ch2Txt.textContent = `Earn 20 coins today (${coinsEarned}/20)`;

    // Daily 3: Flawless Study
    const goldEarned = state.earnedMedals.some(m => m.mistakes === 0);
    if (ch3) ch3.checked = goldEarned;

    // Weekly 1: Earn 500 XP
    if (wch1) wch1.checked = state.xp >= 500;
    if (wch1Txt) wch1Txt.textContent = `Earn 500 XP points (${state.xp}/500)`;

    // Weekly 2: Globe trotter
    const unlockedCount = state.unlockedRegions.length;
    if (wch2) wch2.checked = unlockedCount >= 3;
    if (wch2Txt) wch2Txt.textContent = `Unlock Pakistan & Canada (${Math.min(2, Math.max(0, unlockedCount - 1))}/2)`;
  }

