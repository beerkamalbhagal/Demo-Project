---
// src/components/AdventureApp.astro
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import WorldMap from "./WorldMap.astro";
import LessonWindow from "./LessonWindow.astro";
import TrophyRoom from "./TrophyRoom.astro";
import StatsCenter from "./StatsCenter.astro";
import CultureVault from "./CultureVault.astro";
---
<div class="flex flex-col min-h-screen bg-canvas-dark text-on-dark selection:bg-primary selection:text-white">
  <!-- Navbar -->
  <Navbar />

  <!-- Main Viewports -->
  <main class="flex-grow">
    <!-- Map Screen -->
    <div id="view-MAP" class="screen-view">
      <WorldMap />
    </div>

    <!-- Letters & Numbers Grid Screen -->
    <div id="view-LEARN" class="screen-view hidden bg-canvas-light text-ink py-12 px-4 md:px-8 border-b border-hairline-light">
      <div class="max-w-6xl mx-auto">
        <div class="mb-8 text-center md:text-left flex flex-col md:flex-row justify-between items-end gap-4">
          <div>
            <p class="caption-sm text-primary uppercase font-bold tracking-widest">Interactive Index</p>
            <h1 class="display-lg text-ink mt-1">Letters & Numbers Reference</h1>
            <p class="body-sm text-body-light mt-2">
              Browse Gurmukhi Punjabi letters and numbers. Click any card to hear standard pronunciations.
            </p>
          </div>
          <!-- Selector Pills -->
          <div class="flex bg-surface-soft p-1 rounded-full border border-hairline-light select-none">
            <button id="learn-tab-letters" class="px-4 py-1.5 rounded-full text-xs font-bold bg-primary text-white cursor-pointer">Alphabet (Painti Akhri)</button>
            <button id="learn-tab-numbers" class="px-4 py-1.5 rounded-full text-xs font-bold text-mute-light hover:text-ink transition-colors cursor-pointer">Punjabi Numbers</button>
          </div>
        </div>

        <!-- Alphabet Grid View -->
        <div id="learn-grid-letters" class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-7 gap-4">
          <!-- Letter cards dynamically loaded -->
        </div>

        <!-- Numbers Grid View -->
        <div id="learn-grid-numbers" class="hidden grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-4">
          <!-- Number cards dynamically loaded -->
        </div>
      </div>
    </div>

    <!-- Active Lesson Session Screen -->
    <div id="view-LESSON" class="screen-view hidden">
      <LessonWindow />
    </div>

    <!-- Trophy Museum Screen -->
    <div id="view-MUSEUM" class="screen-view hidden">
      <TrophyRoom />
    </div>

    <!-- Stats Screen -->
    <div id="view-STATS" class="screen-view hidden">
      <StatsCenter />
    </div>

    <!-- Cultural Vault Screen -->
    <div id="view-CULTURE" class="screen-view hidden">
      <CultureVault />
    </div>
  </main>

  <!-- Footer -->
  <Footer />
</div>

<!-- Scripts section for client-side state engine -->
<script>
  import { 
    GURMUKHI_ALPHABET, 
    PUNJABI_NUMBERS, 
    WORLD_REGIONS, 
    getRegionChallenges 
  } from "./GurmukhiData";
  import confetti from "canvas-confetti";

  // State interfaces
  interface MedalEarned {
    lessonName: string;
    mistakes: number;
    xp: number;
    accuracy: number;
    date: string;
  }

  interface UserProgress {
    level: number;
    xp: number;
    coins: number;
    streak: number;
    longestStreak: number;
    lastStudyDate: string;
    unlockedRegions: string[];
    completedLessons: Record<string, number>;
    earnedMedals: MedalEarned[];
    earnedTrophies: string[];
    unlockedPendants: string[];
    readArticles: number[];
    mute: boolean;
    coinsEarnedToday: number;
    lettersTracedToday: number;
  }

  // Initial Default State
  const defaultProgress: UserProgress = {
    level: 1,
    xp: 0,
    coins: 25,
    streak: 0,
    longestStreak: 0,
    lastStudyDate: "",
    unlockedRegions: ["india"],
    completedLessons: {},
    earnedMedals: [],
    earnedTrophies: [],
    unlockedPendants: [],
    readArticles: [],
    mute: false,
    coinsEarnedToday: 0,
    lettersTracedToday: 0
  };

  let state: UserProgress = { ...defaultProgress };

  // Screen tracking
  let currentScreen = "MAP";
  let activeRegionId = "";
  let activeLessonIndex = 0;
  
  // Lesson specific variables
  let currentChallenges: any[] = [];
  let currentChallengeIndex = 0;
  let activeMistakes = 0;
  let activeXpGained = 0;
  let selectedOptionText = "";
  let tracingCompleted = false;

  // Web Audio Context & Sound generator
  let audioCtx: AudioContext | null = null;

  function initAudio() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
    }
  }

  function playTone(freq: number, type: OscillatorType, duration: number, delay = 0) {
    if (state.mute) return;
    initAudio();
    if (!audioCtx) return;

    setTimeout(() => {
      const osc = audioCtx!.createOscillator();
      const gain = audioCtx!.createGain();
      
      osc.type = type;
      osc.frequency.value = freq;
      
      gain.gain.setValueAtTime(0.15, audioCtx!.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx!.currentTime + duration);
      
      osc.connect(gain);
      gain.connect(audioCtx!.destination);
      
      osc.start();
      osc.stop(audioCtx!.currentTime + duration);
    }, delay * 1000);
  }

  // Play game sound effects synthetically
  function playSound(effect: 'correct' | 'error' | 'victory' | 'levelup' | 'click') {
    if (state.mute) return;
    switch (effect) {
      case 'click':
        playTone(600, 'sine', 0.1);
        break;
      case 'correct':
        playTone(650, 'sine', 0.15);
        playTone(850, 'sine', 0.25, 0.1);
        break;
      case 'error':
        playTone(220, 'triangle', 0.2);
        playTone(150, 'triangle', 0.3, 0.15);
        break;
      case 'victory':
        playTone(523.25, 'sine', 0.2); // C5
        playTone(659.25, 'sine', 0.2, 0.15); // E5
        playTone(783.99, 'sine', 0.2, 0.3); // G5
        playTone(1046.50, 'sine', 0.4, 0.45); // C6
        break;
      case 'levelup':
        const scale = [261.63, 329.63, 392.00, 523.25, 659.25, 783.99, 1046.50];
        scale.forEach((note, i) => {
          playTone(note, 'sawtooth', 0.15, i * 0.08);
        });
        break;
    }
  }

  // Pronounce Gurmukhi text using SpeechSynthesis
  function speakGurmukhi(text: string, phonetics: string) {
    if (state.mute) return;
    playSound('click');
    
    // Check if SpeechSynthesis is supported
    if ('speechSynthesis' in window) {
      // Cancel any ongoing speaking
      window.speechSynthesis.cancel();
      
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "pa-IN"; // Punjabi voice
      utterance.rate = 0.85;

      // Fallback behavior if Punjabi voice is not found or fails
      utterance.onerror = () => {
        // Fallback to spelling phonetically with English voice
        const fallbackUtterance = new SpeechSynthesisUtterance(phonetics);
        fallbackUtterance.lang = "en-US";
        fallbackUtterance.rate = 0.75;
        window.speechSynthesis.speak(fallbackUtterance);
      };
      
      window.speechSynthesis.speak(utterance);
    }
  }

  // Local Storage loaders
  function loadProgress() {
    try {
      const saved = localStorage.getItem("my_punjabi_heritage_progress");
      if (saved) {
        state = { ...defaultProgress, ...JSON.parse(saved) };
      } else {
        state = { ...defaultProgress };
      }
    } catch (e) {
      state = { ...defaultProgress };
    }
  }

  function saveProgress() {
    localStorage.setItem("my_punjabi_heritage_progress", JSON.stringify(state));
    updateNavbar();
  }

  // Screen View router
  function showScreen(screenId: string) {
    currentScreen = screenId;
    document.querySelectorAll(".screen-view").forEach(el => el.classList.add("hidden"));
    
    const activeView = document.getElementById(`view-${screenId}`);
    if (activeView) activeView.classList.remove("hidden");

    // Update nav links highlights
    document.querySelectorAll(".nav-tab").forEach(tab => {
      const target = tab.getAttribute("data-nav-target");
      if (target === screenId) {
        tab.classList.add("active");
        tab.classList.remove("text-on-dark-mute");
      } else {
        tab.classList.remove("active");
        tab.classList.add("text-on-dark-mute");
      }
    });

    // Sub-view updates based on loaded screen
    if (screenId === "MAP") {
      updateMapUI();
    } else if (screenId === "LEARN") {
      updateLearnUI();
    } else if (screenId === "MUSEUM") {
      updateMuseumUI();
    } else if (screenId === "STATS") {
      updateStatsUI();
    } else if (screenId === "CULTURE") {
      updateCultureUI();
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Update dynamic values in navigation
  function updateNavbar() {
    const streakEl = document.getElementById("nav-streak-val");
    const coinsEl = document.getElementById("nav-coins-val");
    const lvlEl = document.getElementById("nav-level-val");
    const muteEl = document.getElementById("nav-mute-btn");
    const fillEl = document.getElementById("nav-progress-fill");
    const textEl = document.getElementById("nav-progress-text");
    const rankEl = document.getElementById("nav-rank-val");

    if (streakEl) streakEl.textContent = state.streak.toString();
    if (coinsEl) coinsEl.textContent = state.coins.toString();
    if (lvlEl) lvlEl.textContent = state.level.toString();
    if (muteEl) muteEl.textContent = state.mute ? "🔇" : "🔊";

    // Progress percentage
    const maxExp = 1650; // Total XP threshold for Master Region
    const progressPercent = Math.min(100, Math.round((state.xp / maxExp) * 100));
    if (fillEl) fillEl.style.width = `${progressPercent}%`;
    if (textEl) textEl.textContent = `${progressPercent}%`;

    // Rank descriptor
    let rank = "Beginner Scholar";
    if (state.level >= 10) rank = "Grand Punjabi Master";
    else if (state.level >= 8) rank = "Eldest Scholar";
    else if (state.level >= 6) rank = "Senior Grammarian";
    else if (state.level >= 4) rank = "Intermediate Speaker";
    else if (state.level >= 2) rank = "Literacy Novice";
    
    if (rankEl) rankEl.textContent = rank;
  }

  // Daily Streak checker
  function verifyStreak() {
    if (!state.lastStudyDate) return;
    
    const today = new Date().toDateString();
    const lastDate = new Date(state.lastStudyDate);
    const difference = new Date().getTime() - lastDate.getTime();
    const diffDays = Math.floor(difference / (1000 * 60 * 60 * 24));

    if (diffDays === 1) {
      // Streak continues!
      // (This will be incremented on next lesson completion)
    } else if (diffDays > 1) {
      // Streak broken
      state.streak = 0;
      saveProgress();
    }
  }

  // Map Setup and Node configurations
  function updateMapUI() {
    const statsUnlocked = document.getElementById("map-stats-unlocked");
    const statsProgress = document.getElementById("map-stats-progress");
    
    if (statsUnlocked) statsUnlocked.textContent = `${state.unlockedRegions.length} / 7`;
    
    // Compute total lessons cleared percent
    let clearedCount = 0;
    let totalCount = 0;
    WORLD_REGIONS.forEach(r => {
      clearedCount += state.completedLessons[r.id] || 0;
      totalCount += r.lessonsCount;
    });
    const mapCompletion = Math.round((clearedCount / totalCount) * 100);
    if (statsProgress) statsProgress.textContent = `${mapCompletion}%`;

    // Update node buttons disabled states
    WORLD_REGIONS.forEach(region => {
      const node = document.querySelector(`.map-node[data-region="${region.id}"]`);
      if (node) {
        const btn = node.querySelector(".node-button") as HTMLButtonElement;
        const isUnlocked = state.unlockedRegions.includes(region.id);
        
        if (btn) {
          btn.disabled = !isUnlocked;
          if (isUnlocked) {
            btn.classList.remove("opacity-60");
            btn.classList.add("border-primary", "bg-primary");
            // If active chapter is selected
            if (activeRegionId === region.id) {
              btn.classList.add("active-node");
            } else {
              btn.classList.remove("active-node");
            }
          } else {
            btn.classList.add("opacity-60");
            btn.classList.remove("border-primary", "bg-primary", "active-node");
          }
        }
      }

      // Update path strokes
      // Connection path lines
      const pathKey = `path-${region.id}`;
      // In the layout, paths are named by target node, e.g. path-india-pakistan
    });

    // Differentiate unlocked paths
    const pathIndiaPak = document.getElementById("path-india-pakistan") as SVGPathElement;
    const pathPakCan = document.getElementById("path-pakistan-canada") as SVGPathElement;
    const pathCanUk = document.getElementById("path-canada-uk") as SVGPathElement;
    const pathUkUs = document.getElementById("path-uk-us") as SVGPathElement;
    const pathUsAus = document.getElementById("path-us-australia") as SVGPathElement;
    const pathAusGlob = document.getElementById("path-australia-global") as SVGPathElement;

    if (pathIndiaPak && state.unlockedRegions.includes("pakistan")) {
      pathIndiaPak.setAttribute("stroke", "#0070d1");
      pathIndiaPak.removeAttribute("stroke-dasharray");
    }
    if (pathPakCan && state.unlockedRegions.includes("canada")) {
      pathPakCan.setAttribute("stroke", "#0070d1");
      pathPakCan.removeAttribute("stroke-dasharray");
    }
    if (pathCanUk && state.unlockedRegions.includes("uk")) {
      pathCanUk.setAttribute("stroke", "#0070d1");
      pathCanUk.removeAttribute("stroke-dasharray");
    }
    if (pathUkUs && state.unlockedRegions.includes("us")) {
      pathUkUs.setAttribute("stroke", "#0070d1");
      pathUkUs.removeAttribute("stroke-dasharray");
    }
    if (pathUsAus && state.unlockedRegions.includes("australia")) {
      pathUsAus.setAttribute("stroke", "#0070d1");
      pathUsAus.removeAttribute("stroke-dasharray");
    }
    if (pathAusGlob && state.unlockedRegions.includes("global")) {
      pathAusGlob.setAttribute("stroke", "#0070d1");
      pathAusGlob.removeAttribute("stroke-dasharray");
    }
  }

  // Show detailed tooltip cards for the selected map nodes
  function showMapNodeDetail(regionId: string) {
    const region = WORLD_REGIONS.find(r => r.id === regionId);
    if (!region) return;

    activeRegionId = regionId;
    updateMapUI(); // trigger active highlighting

    const card = document.getElementById("map-detail-card");
    const flag = document.getElementById("detail-flag");
    const title = document.getElementById("detail-title");
    const subtitle = document.getElementById("detail-subtitle");
    const focusList = document.getElementById("detail-focus-list");
    const trophyName = document.getElementById("detail-trophy-name");
    const pendantName = document.getElementById("detail-pendant-name");
    const ctaBtn = document.getElementById("detail-cta-btn") as HTMLButtonElement;
    const unlockedStatus = document.getElementById("detail-unlocked-status");

    if (!card || !flag || !title || !subtitle || !focusList || !trophyName || !pendantName || !ctaBtn || !unlockedStatus) return;

    flag.textContent = region.flag;
    title.textContent = region.name;
    subtitle.textContent = region.subtitle;
    
    // Clear & load focus
    focusList.innerHTML = "";
    region.focus.forEach(item => {
      const li = document.createElement("li");
      li.textContent = item;
      focusList.appendChild(li);
    });

    trophyName.textContent = `🏆 ${region.rewards.trophy.name}`;
    pendantName.textContent = `${region.rewards.pendant.icon} ${region.rewards.pendant.name}`;

    const isUnlocked = state.unlockedRegions.includes(regionId);
    if (isUnlocked) {
      unlockedStatus.textContent = "UNLOCKED";
      unlockedStatus.className = "caption-sm bg-primary/20 text-primary border border-primary/40 px-2 py-0.5 rounded-full font-bold";
      
      const clearedLessons = state.completedLessons[regionId] || 0;
      if (clearedLessons >= region.lessonsCount) {
        ctaBtn.textContent = "REVIEW CHAMPION STUDY";
        ctaBtn.className = "w-full py-2.5 rounded-full bg-green-600 hover:bg-green-700 text-white font-bold text-sm tracking-wider shadow-lg transition-colors flex items-center justify-center gap-2";
      } else {
        ctaBtn.textContent = `START CHAPTER (Lesson ${clearedLessons + 1}/${region.lessonsCount})`;
        ctaBtn.className = "w-full py-2.5 rounded-full bg-primary hover:bg-primary-pressed text-white font-bold text-sm tracking-wider shadow-lg transition-colors flex items-center justify-center gap-2";
      }
      ctaBtn.disabled = false;
    } else {
      unlockedStatus.textContent = "LOCKED";
      unlockedStatus.className = "caption-sm bg-red-500/20 text-red-500 border border-red-500/40 px-2 py-0.5 rounded-full font-bold";
      ctaBtn.textContent = `LOCKED (Requires ${region.unlockedAtXp} XP)`;
      ctaBtn.className = "w-full py-2.5 rounded-full bg-charcoal text-on-dark-mute font-bold text-sm tracking-wider cursor-not-allowed";
      ctaBtn.disabled = true;
    }

    card.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
    playSound('click');
  }

  // Alphabet & Numbers Tab Reference UI builder
  let learnSubTab = "letters";

  function updateLearnUI() {
    const lettersGrid = document.getElementById("learn-grid-letters");
    const numbersGrid = document.getElementById("learn-grid-numbers");
    const tabLetters = document.getElementById("learn-tab-letters");
    const tabNumbers = document.getElementById("learn-tab-numbers");

    if (!lettersGrid || !numbersGrid || !tabLetters || !tabNumbers) return;

    if (learnSubTab === "letters") {
      lettersGrid.classList.remove("hidden");
      numbersGrid.classList.add("hidden");
      tabLetters.className = "px-4 py-1.5 rounded-full text-xs font-bold bg-primary text-white cursor-pointer";
      tabNumbers.className = "px-4 py-1.5 rounded-full text-xs font-bold text-mute-light hover:text-ink transition-colors cursor-pointer";

      // Render 35 main letters
      lettersGrid.innerHTML = "";
      GURMUKHI_ALPHABET.forEach(letter => {
        const div = document.createElement("div");
        div.className = "bg-white border border-hairline-light rounded-md p-4 text-center cursor-pointer hover:border-primary active:scale-95 duration-200 shadow-sm flex flex-col items-center select-none";
        div.innerHTML = `
          <span class="text-4xl font-display font-bold text-primary">${letter.char}</span>
          <span class="text-xs font-semibold text-ink mt-2">${letter.name}</span>
          <span class="text-[10px] text-mute-light">${letter.translit} (${letter.sound})</span>
          <span class="text-[10px] mt-1 bg-surface-soft px-1.5 py-0.5 rounded text-mute-light font-mono">${letter.exampleGurmukhi} : ${letter.exampleMeaning}</span>
        `;
        div.addEventListener("click", () => speakGurmukhi(letter.char, letter.name));
        lettersGrid.appendChild(div);
      });

    } else {
      lettersGrid.classList.add("hidden");
      numbersGrid.classList.remove("hidden");
      tabLetters.className = "px-4 py-1.5 rounded-full text-xs font-bold text-mute-light hover:text-ink transition-colors cursor-pointer";
      tabNumbers.className = "px-4 py-1.5 rounded-full text-xs font-bold bg-primary text-white cursor-pointer";

      // Render Punjabi numbers
      numbersGrid.innerHTML = "";
      PUNJABI_NUMBERS.forEach(num => {
        const div = document.createElement("div");
        div.className = "bg-white border border-hairline-light rounded-md p-4 text-center cursor-pointer hover:border-primary active:scale-95 duration-200 shadow-sm flex flex-col items-center select-none";
        div.innerHTML = `
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-display font-bold text-primary">${num.char}</span>
            <span class="text-sm font-semibold text-mute-light">(${num.value})</span>
          </div>
          <span class="text-xs font-bold text-ink mt-2">${num.word}</span>
          <span class="text-[10px] text-mute-light font-mono">${num.translit}</span>
          <span class="text-[10px] text-mute-light italic mt-0.5">${num.meaning}</span>
        `;
        div.addEventListener("click", () => speakGurmukhi(num.word, num.translit));
        numbersGrid.appendChild(div);
      });
    }
  }

  // Museum UI builder (Trophies, Medals, Pendants)
  let museumSubTab = "trophies";

  function updateMuseumUI() {
    const viewTrophies = document.getElementById("museum-view-trophies");
    const viewMedals = document.getElementById("museum-view-medals");
    const viewPendants = document.getElementById("museum-view-pendants");

    const tabTrophies = document.getElementById("museum-tab-trophies");
    const tabMedals = document.getElementById("museum-tab-medals");
    const tabPendants = document.getElementById("museum-tab-pendants");

    if (!viewTrophies || !viewMedals || !viewPendants || !tabTrophies || !tabMedals || !tabPendants) return;

    viewTrophies.classList.add("hidden");
    viewMedals.classList.add("hidden");
    viewPendants.classList.add("hidden");
    
    tabTrophies.className = "museum-tab-btn px-4 py-1.5 rounded-full text-xs font-bold text-on-dark-mute hover:text-white transition-colors cursor-pointer";
    tabMedals.className = "museum-tab-btn px-4 py-1.5 rounded-full text-xs font-bold text-on-dark-mute hover:text-white transition-colors cursor-pointer";
    tabPendants.className = "museum-tab-btn px-4 py-1.5 rounded-full text-xs font-bold text-on-dark-mute hover:text-white transition-colors cursor-pointer";

    if (museumSubTab === "trophies") {
      viewTrophies.classList.remove("hidden");
      tabTrophies.className = "museum-tab-btn px-4 py-1.5 rounded-full text-xs font-bold bg-primary text-white cursor-pointer";
      
      // Update trophies display silhouettes based on user unlock state
      const coreTrophies = ["alphabet", "numbers", "listening", "reading", "india", "pakistan", "canada", "uk", "us", "australia", "global"];
      
      coreTrophies.forEach(tId => {
        const isUnlocked = state.earnedTrophies.includes(tId);
        const artEl = document.getElementById(`trophy-art-${tId}`);
        const statusEl = document.getElementById(`trophy-status-${tId}`);
        
        if (artEl) {
          if (isUnlocked) {
            artEl.classList.remove("grayscale", "brightness-50");
            artEl.classList.add("animate-bounce-slow");
          } else {
            artEl.classList.add("grayscale", "brightness-50");
          }
        }
        if (statusEl) {
          if (isUnlocked) {
            statusEl.textContent = "UNLOCKED";
            statusEl.className = "text-[9px] uppercase tracking-wider text-green-400 font-bold block mt-1";
          } else {
            statusEl.textContent = "LOCKED";
            statusEl.className = "text-[9px] uppercase tracking-wider text-red-500 font-bold block mt-1";
          }
        }
      });

    } else if (museumSubTab === "medals") {
      viewMedals.classList.remove("hidden");
      tabMedals.className = "museum-tab-btn px-4 py-1.5 rounded-full text-xs font-bold bg-primary text-white cursor-pointer";

      // Render hanging medals rack
      const emptyState = document.getElementById("medals-empty-state");
      const listEl = document.getElementById("medals-rack-container");

      if (!emptyState || !listEl) return;

      if (state.earnedMedals.length === 0) {
        emptyState.classList.remove("hidden");
        listEl.classList.add("hidden");
      } else {
        emptyState.classList.add("hidden");
        listEl.classList.remove("hidden");
        listEl.innerHTML = "";

        state.earnedMedals.forEach(medal => {
          const card = document.createElement("div");
          card.className = "bg-surface-dark-card border border-hairline-dark rounded-md p-4 flex items-center justify-between shadow-sm relative";
          
          let medalEmoji = "🥉";
          if (medal.mistakes === 0) medalEmoji = "🥇";
          else if (medal.mistakes === 1) medalEmoji = "🥈";
          else if (medal.mistakes === 2) medalEmoji = "🥉";
          else if (medal.mistakes === 3) medalEmoji = "🥉";
          else medalEmoji = "🏅";

          card.innerHTML = `
            <div class="flex items-center gap-4">
              <span class="text-4xl">${medalEmoji}</span>
              <div>
                <h4 class="font-bold text-sm text-on-dark">${medal.lessonName}</h4>
                <p class="caption-md text-on-dark-mute mt-0.5">Accuracy: ${medal.accuracy}% • ${medal.mistakes} mistakes</p>
