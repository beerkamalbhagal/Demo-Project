  function loadChallenge() {
    const challenge = currentChallenges[currentChallengeIndex];
    if (!challenge) {
      finishLesson();
      return;
    }

    // Update headers
    const progressFill = document.getElementById("lesson-progress-fill");
    const progressText = document.getElementById("lesson-progress-text");
    const mistakesCount = document.getElementById("lesson-mistakes-count");
    const xpGained = document.getElementById("lesson-xp-gained");
    const title = document.getElementById("lesson-question-title");
    const submitBtn = document.getElementById("lesson-submit-btn") as HTMLButtonElement;

    if (progressFill) progressFill.style.width = `${((currentChallengeIndex) / currentChallenges.length) * 100}%`;
    if (progressText) progressText.textContent = `Q ${currentChallengeIndex + 1}/${currentChallenges.length}`;
    if (mistakesCount) mistakesCount.textContent = activeMistakes.toString();
    if (xpGained) xpGained.textContent = activeXpGained.toString();
    if (title) title.textContent = challenge.question;
    
    if (submitBtn) {
      submitBtn.textContent = "CHECK ANSWER";
      submitBtn.disabled = true;
    }

    // Reset tracing Completeness
    tracingCompleted = false;

    // Hide all question bodies
    document.getElementById("body-card-letter")?.classList.add("hidden");
    document.getElementById("body-card-listening")?.classList.add("hidden");
    document.getElementById("body-card-tracing")?.classList.add("hidden");
    document.getElementById("speaking-container")?.classList.add("hidden");

    // Populate question body based on challenge type
    if (challenge.type === 'letter-recognition' || challenge.type === 'vocabulary') {
      const letter = GURMUKHI_ALPHABET.find(l => challenge.question.includes(`'${l.char}'`));
      if (letter) {
        document.getElementById("body-card-letter")?.classList.remove("hidden");
        const charEl = document.getElementById("large-letter-char");
        const nameEl = document.getElementById("large-letter-name");
        if (charEl) charEl.textContent = letter.char;
        if (nameEl) nameEl.textContent = letter.name;
      }
    } else if (challenge.type === 'listening') {
      document.getElementById("body-card-listening")?.classList.remove("hidden");
      // Setup replay button listener
      const replayBtn = document.getElementById("replay-audio-btn");
      if (replayBtn) {
        replayBtn.onclick = () => {
          speakGurmukhi(challenge.audioPrompt === 'Ik' || challenge.audioPrompt === 'Do' ? 'ਇੱਕ' : challenge.answer, challenge.audioPrompt || "");
        };
        // Play once initially
        speakGurmukhi(challenge.answer, challenge.audioPrompt || "");
      }
    } else if (challenge.type === 'writing' && challenge.targetLetter) {
      document.getElementById("body-card-tracing")?.classList.remove("hidden");
      initTracingCanvas(challenge.targetLetter);
    }

    // Populate Multiple Choice Option Buttons
    const optionsContainer = document.getElementById("lesson-options-container");
    if (optionsContainer) {
      optionsContainer.innerHTML = "";
      
      if (challenge.options) {
        optionsContainer.classList.remove("hidden");
        challenge.options.forEach((opt: string) => {
          const btn = document.createElement("button");
          btn.className = "w-full p-4 bg-surface-soft hover:bg-ash-light border border-hairline-light rounded-md font-bold text-sm tracking-wide text-ink text-center cursor-pointer transition-all active:scale-[0.98]";
          btn.textContent = opt;
          
          btn.addEventListener("click", () => {
