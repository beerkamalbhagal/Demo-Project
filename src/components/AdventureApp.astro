            document.querySelectorAll("#lesson-options-container button").forEach(b => {
              b.className = "w-full p-4 bg-surface-soft hover:bg-ash-light border border-hairline-light rounded-md font-bold text-sm tracking-wide text-ink text-center cursor-pointer transition-all active:scale-[0.98]";
            });
            btn.className = "w-full p-4 bg-primary text-white border-2 border-primary-pressed rounded-md font-bold text-sm tracking-wide text-center cursor-pointer transition-all shadow-md";
            
            selectedOptionText = opt;
            if (submitBtn) submitBtn.disabled = false;
            playSound('click');
          });
          
          optionsContainer.appendChild(btn);
        });
      } else {
        // Tracing doesn't need multiple choices
        optionsContainer.classList.add("hidden");
      }
    }
  }

  // Drawing Canvas Tracing Logic
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let isDrawing = false;
  let pathPoints: any[] = [];
  let completedStrokePoints: number[] = []; // tracks matching points indexes in reference coordinates

  function initTracingCanvas(letter: any) {
    canvas = document.getElementById("tracing-canvas") as HTMLCanvasElement;
    if (!canvas) return;

    ctx = canvas.getContext("2d");
    if (!ctx) return;

    // Reset canvas dimensions and styles
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.lineWidth = 14;
    ctx.lineCap = "round";
    ctx.lineJoin = "round";
    ctx.strokeStyle = "#0070d1"; // PlayStation Blue

    // Draw reference stroke guide paths onto SVG
    const svgPath = document.getElementById("tracing-guide-path");
    const activePath = document.getElementById("tracing-active-path");
    const markers = document.getElementById("tracing-markers");

    // Flatten strokes coordinate reference list to draw guide indicators
    let svgString = "";
    if (markers) markers.innerHTML = "";
    
    pathPoints = [];
    letter.strokes.forEach((stroke: any) => {
      if (stroke.length === 0) return;
      svgString += `M ${stroke[0].x * 2.56} ${stroke[0].y * 2.56} `;
      
      stroke.forEach((pt: any, i: number) => {
        pathPoints.push({ x: pt.x * 2.56, y: pt.y * 2.56, strokeIdx: pathPoints.length });
        if (i > 0) {
          svgString += `L ${pt.x * 2.56} ${pt.y * 2.56} `;
        }
      });
    });

    if (svgPath) svgPath.setAttribute("d", svgString);
    if (activePath) activePath.setAttribute("d", svgString);

    // Draw green starting dot indicator and red ending indicator
    if (markers && pathPoints.length > 0) {
      const startPt = pathPoints[0];
      const startDot = document.createElement("div");
      startDot.className = "absolute w-4 h-4 rounded-full bg-green-500 border border-white shadow animate-pulse";
      startDot.style.left = `${(startPt.x / 256) * 100}%`;
      startDot.style.top = `${(startPt.y / 256) * 100}%`;
      startDot.style.transform = "translate(-50%, -50%)";
      markers.appendChild(startDot);
    }

    completedStrokePoints = [];
    isDrawing = false;

    // Remove old events
    canvas.replaceWith(canvas.cloneNode(true));
    canvas = document.getElementById("tracing-canvas") as HTMLCanvasElement;
    ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.lineWidth = 14;
    ctx.lineCap = "round";
    ctx.lineJoin = "round";
    ctx.strokeStyle = "#0070d1";

    const getPos = (e: MouseEvent | TouchEvent) => {
      const rect = canvas!.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      return {
        x: ((clientX - rect.left) / rect.width) * canvas!.width,
        y: ((clientY - rect.top) / rect.height) * canvas!.height
      };
    };

    const drawStart = (e: MouseEvent | TouchEvent) => {
      e.preventDefault();
      isDrawing = true;
      const pos = getPos(e);
      ctx!.beginPath();
      ctx!.moveTo(pos.x, pos.y);
      checkPointDistance(pos.x, pos.y);
    };

    const drawMove = (e: MouseEvent | TouchEvent) => {
      e.preventDefault();
      if (!isDrawing) return;
      const pos = getPos(e);
      ctx!.lineTo(pos.x, pos.y);
      ctx!.stroke();
      checkPointDistance(pos.x, pos.y);
    };

    const drawEnd = () => {
      isDrawing = false;
    };

    canvas.addEventListener("mousedown", drawStart);
    canvas.addEventListener("mousemove", drawMove);
    canvas.addEventListener("mouseup", drawEnd);
    canvas.addEventListener("mouseleave", drawEnd);

    canvas.addEventListener("touchstart", drawStart);
    canvas.addEventListener("touchmove", drawMove);
    canvas.addEventListener("touchend", drawEnd);
  }

  function checkPointDistance(x: number, y: number) {
    pathPoints.forEach((refPt) => {
      if (completedStrokePoints.includes(refPt.strokeIdx)) return;
      
      // Math distance
      const dist = Math.hypot(x - refPt.x, y - refPt.y);
      if (dist < 22) { // 22px tolerance circle boundary
        completedStrokePoints.push(refPt.strokeIdx);
        // play tiny quiet click tone on node connection
        playTone(700, 'sine', 0.05);
      }
    });

    // Check if the tracing is completed (e.g. user covered at least 80% of coordinates)
    const ratio = completedStrokePoints.length / pathPoints.length;
    if (ratio >= 0.85 && !tracingCompleted) {
      tracingCompleted = true;
      const submitBtn = document.getElementById("lesson-submit-btn") as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "COMPLETED! CLICK CHECK";
      }
      // Draw flashing gold outline on SVG guide
      const guide = document.getElementById("tracing-active-path");
      if (guide) {
        guide.setAttribute("stroke", "#ffce21");
      }
      playSound('correct');
    }
  }

  // Answer validation engine
  function checkAnswer() {
    const challenge = currentChallenges[currentChallengeIndex];
    const submitBtn = document.getElementById("lesson-submit-btn") as HTMLButtonElement;
    if (!challenge || !submitBtn) return;

    if (submitBtn.textContent === "CONTINUE") {
      // Advance to next challenge
      currentChallengeIndex++;
      loadChallenge();
      return;
    }

    let isCorrect = false;

    if (challenge.type === 'writing') {
      isCorrect = tracingCompleted;
      state.lettersTracedToday++;
    } else {
      isCorrect = selectedOptionText === challenge.answer;
    }

    if (isCorrect) {
      playSound('correct');
      activeXpGained += 10;
      submitBtn.textContent = "CONTINUE";
      submitBtn.className = "px-8 py-3 rounded-full bg-green-600 hover:bg-green-700 text-white font-bold text-sm tracking-wider shadow-lg transition-colors cursor-pointer";
      
      // Highlight option card
      const activeBtns = document.querySelectorAll("#lesson-options-container button");
      activeBtns.forEach(btn => {
        if (btn.textContent === challenge.answer) {
          btn.className = "w-full p-4 bg-green-600 text-white border-2 border-green-700 rounded-md font-bold text-sm tracking-wide text-center";
        }
      });
    } else {
      playSound('error');
      activeMistakes++;
      // Show correct highlight in options
      const activeBtns = document.querySelectorAll("#lesson-options-container button");
      activeBtns.forEach(btn => {
        if (btn.textContent === challenge.answer) {
          btn.className = "w-full p-4 bg-green-600 text-white border-2 border-green-700 rounded-md font-bold text-sm tracking-wide text-center";
        } else if (btn.textContent === selectedOptionText) {
          btn.className = "w-full p-4 bg-red-600 text-white border-2 border-red-700 rounded-md font-bold text-sm tracking-wide text-center";
        }
      });

      submitBtn.textContent = "CONTINUE";
      submitBtn.className = "px-8 py-3 rounded-full bg-green-600 hover:bg-green-700 text-white font-bold text-sm tracking-wider shadow-lg transition-colors cursor-pointer";
    }

    // Refresh XP headers
    const xpGained = document.getElementById("lesson-xp-gained");
    const mistakesCount = document.getElementById("lesson-mistakes-count");
    if (xpGained) xpGained.textContent = activeXpGained.toString();
    if (mistakesCount) mistakesCount.textContent = activeMistakes.toString();
  }

  // Finish session calculations (Gold/Silver medals, coins payouts)
  function finishLesson() {
    document.getElementById("lesson-viewport")?.classList.add("hidden");
    const screen = document.getElementById("lesson-summary-screen");
    if (!screen) return;

    screen.classList.remove("hidden");

    // Hide level panel by default
    document.getElementById("summary-level-panel")?.classList.add("hidden");

    // Compute metrics
    const totalQ = currentChallenges.length;
    const correctCount = Math.max(0, totalQ - activeMistakes);
    const accuracy = Math.round((correctCount / totalQ) * 100);

    // Medal checks
    let medalEmoji = "🏆";
    let medalTitle = "Gold Medal";
    let headline = "Perfect Study!";
    let tagline = "You completed the lesson with zero mistakes.";
    let coinsPaid = 15;
    let xpBonus = 30;

    if (activeMistakes === 0) {
      medalEmoji = "🥇";
      medalTitle = "Gold Medal";
      headline = "Perfect Flawless Study!";
      tagline = "You completed the lesson with absolute perfection.";
      coinsPaid = 20;
      xpBonus = 40;
    } else if (activeMistakes === 1) {
      medalEmoji = "🥈";
      medalTitle = "Silver Medal";
      headline = "Excellent Study!";
      tagline = "Only a single slip! Beautiful work.";
      coinsPaid = 15;
      xpBonus = 25;
    } else if (activeMistakes === 2) {
      medalEmoji = "🥉";
      medalTitle = "Bronze Medal";
      headline = "Good Effort!";
      tagline = "You completed the study with minor mistakes.";
      coinsPaid = 10;
      xpBonus = 15;
    } else if (activeMistakes === 3) {
      medalEmoji = "🥉";
      medalTitle = "Copper Medal";
      headline = "Study Passed!";
      tagline = "Keep practicing. You're building vocabulary.";
      coinsPaid = 5;
      xpBonus = 10;
    } else {
      medalEmoji = "🏅";
      medalTitle = "Participation Medal";
      headline = "Keep Trying!";
      tagline = "Review your cards. Repetition is key to fluency.";
      coinsPaid = 2;
      xpBonus = 5;
    }

    // Set UI elements
    const iconEl = document.getElementById("summary-medal-icon");
    const headlineEl = document.getElementById("summary-headline");
    const taglineEl = document.getElementById("summary-tagline");
    const accuracyEl = document.getElementById("summary-accuracy");
    const mistakesEl = document.getElementById("summary-mistakes");
    const xpEl = document.getElementById("summary-xp");
    const coinsEl = document.getElementById("summary-coins");
    const regionNameEl = document.getElementById("summary-region-name");

    if (iconEl) iconEl.textContent = medalEmoji;
    if (headlineEl) headlineEl.textContent = headline;
    if (taglineEl) taglineEl.textContent = tagline;
    if (accuracyEl) accuracyEl.textContent = `${accuracy}%`;
    if (mistakesEl) mistakesEl.textContent = activeMistakes.toString();
    if (xpEl) xpEl.textContent = `+${activeXpGained + xpBonus} XP`;
    if (coinsEl) coinsEl.textContent = `+${coinsPaid}`;

    const region = WORLD_REGIONS.find(r => r.id === activeRegionId);
    if (regionNameEl && region) regionNameEl.textContent = region.name;

    // Apply currency and XP changes
    awardXp(activeXpGained + xpBonus);
    state.coins += coinsPaid;
    state.coinsEarnedToday += coinsPaid;

    // Record study log date
    const today = new Date().toDateString();
    if (state.lastStudyDate !== today) {
      state.streak++;
      if (state.streak > state.longestStreak) {
        state.longestStreak = state.streak;
      }
      state.lastStudyDate = today;
    }

    // Log the earned medal details
    const newMedal: MedalEarned = {
      lessonName: `${region?.name || "Gurmukhi"} Lesson ${activeLessonIndex + 1}`,
      mistakes: activeMistakes,
      xp: activeXpGained + xpBonus,
      accuracy,
      date: new Date().toISOString()
    };
    state.earnedMedals.push(newMedal);

    // Save lesson completion index
    const prevCompleted = state.completedLessons[activeRegionId] || 0;
    if (activeLessonIndex >= prevCompleted) {
      state.completedLessons[activeRegionId] = activeLessonIndex + 1;
    }

    // Reward unlocks!
    const rewardBox = document.getElementById("summary-reward-box");
    const rewardIcon = document.getElementById("summary-reward-icon");
    const rewardTitle = document.getElementById("summary-reward-title");
    const rewardDesc = document.getElementById("summary-reward-desc");

    if (rewardBox && rewardIcon && rewardTitle && rewardDesc && region) {
      rewardBox.classList.add("hidden");
      
      const regionClearedCount = state.completedLessons[activeRegionId] || 0;
      if (regionClearedCount >= region.lessonsCount) {
        let unlockedSomething = false;
        
        // 1. Unlock next country region
        const nextRegionIdx = WORLD_REGIONS.findIndex(r => r.id === activeRegionId) + 1;
        if (nextRegionIdx < WORLD_REGIONS.length) {
          const nextReg = WORLD_REGIONS[nextRegionIdx];
          if (!state.unlockedRegions.includes(nextReg.id)) {
            state.unlockedRegions.push(nextReg.id);
            unlockedSomething = true;
          }
        }

        // 2. Unlock Regional Pendant
        if (!state.unlockedPendants.includes(activeRegionId)) {
          state.unlockedPendants.push(activeRegionId);
          rewardIcon.textContent = region.rewards.pendant.icon;
          rewardTitle.textContent = region.rewards.pendant.name;
          rewardDesc.textContent = `${region.rewards.pendant.rarity} Pendant Relic: ${region.rewards.pendant.desc}`;
          rewardBox.classList.remove("hidden");
          unlockedSomething = true;
        }

        // 3. Unlock Regional Trophy
        if (!state.earnedTrophies.includes(activeRegionId)) {
          state.earnedTrophies.push(activeRegionId);
          unlockedSomething = true;
        }

        // 4. Core trophies unlocks
        if (activeRegionId === "india" && !state.earnedTrophies.includes("alphabet")) {
          state.earnedTrophies.push("alphabet");
        }
        if (activeRegionId === "canada" && !state.earnedTrophies.includes("numbers")) {
          state.earnedTrophies.push("numbers");
        }
        if (activeRegionId === "uk" && !state.earnedTrophies.includes("reading")) {
          state.earnedTrophies.push("reading");
        }
        if (activeRegionId === "australia" && !state.earnedTrophies.includes("listening")) {
          state.earnedTrophies.push("listening");
        }
      }
    }

    // Save modifications
    saveProgress();
    playSound('victory');

    // Confetti burst on flawless completion
    if (activeMistakes === 0) {
      confetti({
        particleCount: 120,
        spread: 80,
        origin: { y: 0.6 }
      });
    }
  }

  // Mount Event Listeners once loaded on client
  window.addEventListener("DOMContentLoaded", () => {
    loadProgress();
    verifyStreak();
    saveProgress();
    showScreen("MAP");

    // NAV LINK BUTTONS CLICKS
    document.querySelectorAll("[data-nav-target]").forEach(btn => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-nav-target") || "MAP";
        showScreen(target);
      });
    });

    // Logo click redirect
    document.getElementById("nav-logo-btn")?.addEventListener("click", () => {
      showScreen("MAP");
    });

    // Mute Button toggle
    document.getElementById("nav-mute-btn")?.addEventListener("click", () => {
      state.mute = !state.mute;
      saveProgress();
    });

    // MAP HOVERS & CLICKS ON COUNTRY NODES
    document.querySelectorAll(".node-button").forEach(btn => {
      btn.addEventListener("click", (e) => {
        const parent = (e.currentTarget as HTMLElement).parentElement;
        const regionId = parent?.getAttribute("data-region") || "";
        showMapNodeDetail(regionId);
      });
    });

    // Map Detail chapter trigger CTA
    document.getElementById("detail-cta-btn")?.addEventListener("click", () => {
      const region = WORLD_REGIONS.find(r => r.id === activeRegionId);
      if (region) {
        const cleared = state.completedLessons[activeRegionId] || 0;
        const lessonIdx = Math.min(region.lessonsCount - 1, cleared);
        startLesson(activeRegionId, lessonIdx);
      }
    });

    // EXIT LESSON DIALOG
    document.getElementById("lesson-exit-btn")?.addEventListener("click", () => {
      if (confirm("Are you sure you want to exit? You will lose current lesson progress.")) {
        playSound('click');
        showScreen("MAP");
      }
    });

    // LESSON SUBMIT CHECK
    document.getElementById("lesson-submit-btn")?.addEventListener("click", () => {
      checkAnswer();
    });

    // OPTIONAL: Skip to next question (no back navigation)
    document.getElementById("lesson-skip-btn")?.addEventListener("click", () => {
      // Skip is allowed only while the lesson viewport is visible.
      if (!submitBtnAllowsAdvance()) return;

      const challenge = currentChallenges[currentChallengeIndex];
      if (challenge) activeMistakes++;

      // Move forward; do not allow going back.
      currentChallengeIndex++;
      loadChallenge();
    });

    function submitBtnAllowsAdvance() {
      const lessonSubmitBtn = document.getElementById("lesson-submit-btn") as HTMLButtonElement | null;
      // Allow skip only during an active lesson viewport (not summary)
      const viewport = document.getElementById("lesson-viewport");
      if (!viewport || viewport.classList.contains("hidden")) return false;
      return !!lessonSubmitBtn;
    }


    // CLEAR TRACING CANVAS
    document.getElementById("clear-trace-btn")?.addEventListener("click", () => {
      const challenge = currentChallenges[currentChallengeIndex];
      if (challenge && challenge.targetLetter) {
        initTracingCanvas(challenge.targetLetter);
      }
    });

    // SUMMARY CONTINUE BTN
    document.getElementById("summary-continue-btn")?.addEventListener("click", () => {
      playSound('click');
      showScreen("MAP");
    });

    // INDEX SELECTOR PILLS
    document.getElementById("learn-tab-letters")?.addEventListener("click", () => {
      learnSubTab = "letters";
      playSound('click');
      updateLearnUI();
    });
    document.getElementById("learn-tab-numbers")?.addEventListener("click", () => {
      learnSubTab = "numbers";
      playSound('click');
      updateLearnUI();
    });

    // MUSEUM TAB SELECTORS
    document.getElementById("museum-tab-trophies")?.addEventListener("click", () => {
      museumSubTab = "trophies";
      playSound('click');
      updateMuseumUI();
    });
    document.getElementById("museum-tab-medals")?.addEventListener("click", () => {
      museumSubTab = "medals";
      playSound('click');
      updateMuseumUI();
    });
    document.getElementById("museum-tab-pendants")?.addEventListener("click", () => {
      museumSubTab = "pendants";
      playSound('click');
      updateMuseumUI();
    });

    // TROPHY SLOTS DETAILS INSPECTOR
    document.querySelectorAll(".trophy-slot").forEach(slot => {
      slot.addEventListener("click", () => {
        const trophyId = slot.getAttribute("data-trophy-id") || "";
        showTrophyInspection(trophyId);
      });
    });

    // TROPHY CLOSE INSPECTION
    const closeInspect = () => {
      const modal = document.getElementById("trophy-inspect-modal");
      if (modal) modal.classList.add("opacity-0", "pointer-events-none");
      playSound('click');
    };
    document.getElementById("inspect-close-btn")?.addEventListener("click", closeInspect);
    document.getElementById("inspect-dismiss-btn")?.addEventListener("click", closeInspect);

    // 3D Trophy spin drag simulation events
    const obj3d = document.getElementById("inspect-3d-object");
    const wrap3d = document.getElementById("inspect-3d-model-wrapper");
    if (obj3d && wrap3d) {
      wrap3d.addEventListener("mousedown", (e) => {
        isDraggingTrophy = true;
        startX = (e as MouseEvent).clientX;
      });

      window.addEventListener("mousemove", (e) => {
        if (!isDraggingTrophy) return;
        const deltaX = e.clientX - startX;
        currentRotation += deltaX * 0.75;
        obj3d.style.transform = `rotateY(${currentRotation}deg)`;
        startX = e.clientX;
      });

      window.addEventListener("mouseup", () => {
        isDraggingTrophy = false;
      });
    }

    // PENDANT HOOK CLICK HANDLER
    document.querySelectorAll(".pendant-hook").forEach(hook => {
      hook.addEventListener("click", () => {
        const pId = hook.getAttribute("data-pendant-id") || "";
        inspectPendant(pId);
      });
    });

    // CULTURE SLIDE DETAIL READER
    document.querySelectorAll("[data-article-id]").forEach(card => {
      card.querySelector(".claim-culture-btn")?.addEventListener("click", (e) => {
        e.stopPropagation(); // prevent card click bubble
        const aId = parseInt(card.getAttribute("data-article-id") || "0");
        readArticle(aId);
      });
      card.addEventListener("click", () => {
        const aId = parseInt(card.getAttribute("data-article-id") || "0");
        readArticle(aId);
      });
    });

    document.getElementById("culture-close-btn")?.addEventListener("click", () => {
      const modal = document.getElementById("culture-article-modal");
      if (modal) modal.classList.add("opacity-0", "pointer-events-none");
      playSound('click');
    });

    document.getElementById("modal-article-claim-btn")?.addEventListener("click", () => {
      claimArticleXp();
    });

    // Reset progress helper for debugging if required (uncomment if need manual reset)
    // window.resetProgress = () => { localStorage.clear(); location.reload(); };
  });
</script>
