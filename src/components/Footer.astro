---
// src/components/Footer.astro
---
<footer class="bg-primary text-on-primary font-body py-12 px-6 border-t border-primary-pressed select-none mt-auto">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
    <!-- Brand Info -->
    <div class="md:col-span-2 flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-white text-primary flex items-center justify-center font-bold text-xl shadow-md">
          ਪ
        </div>
        <span class="font-display font-light text-2xl tracking-widest uppercase">
          Punjabi <span class="font-semibold text-white">Adventure</span>
        </span>
      </div>
      <p class="caption-md text-white/80 max-w-sm">
        A premium gamified language-learning experience designed to make learning the Gurmukhi script and Punjabi vocabulary addictive, visually satisfying, and deeply rewarding.
      </p>
    </div>

    <!-- Quick Links -->
    <div>
      <h4 class="font-bold text-base mb-3 uppercase tracking-wider text-white">Adventure Map</h4>
      <ul class="space-y-2 text-sm text-white/80">
        <li><button data-nav-target="MAP" class="footer-link-btn hover:text-white transition-colors">Punjab, India</button></li>
        <li><button data-nav-target="MAP" class="footer-link-btn hover:text-white transition-colors">Punjab, Pakistan</button></li>
        <li><button data-nav-target="MAP" class="footer-link-btn hover:text-white transition-colors">Canada Diaspora</button></li>
        <li><button data-nav-target="MAP" class="footer-link-btn hover:text-white transition-colors">United Kingdom</button></li>
        <li><button data-nav-target="MAP" class="footer-link-btn hover:text-white transition-colors">United States & Australia</button></li>
      </ul>
    </div>

    <!-- Study Resources -->
    <div>
      <h4 class="font-bold text-base mb-3 uppercase tracking-wider text-white">Museum & Stats</h4>
      <ul class="space-y-2 text-sm text-white/80">
        <li><button data-nav-target="MUSEUM" class="footer-link-btn hover:text-white transition-colors">Trophy shelves</button></li>
        <li><button data-nav-target="MUSEUM" class="footer-link-btn hover:text-white transition-colors">Hanging Medals Rack</button></li>
        <li><button data-nav-target="MUSEUM" class="footer-link-btn hover:text-white transition-colors">Pendant Showcase</button></li>
        <li><button data-nav-target="STATS" class="footer-link-btn hover:text-white transition-colors">Level & XP History</button></li>
        <li><button data-nav-target="CULTURE" class="footer-link-btn hover:text-white transition-colors">Cultural Vault</button></li>
      </ul>
    </div>
  </div>

  <div class="max-w-6xl mx-auto border-t border-white/20 mt-8 pt-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-white/75">
    <p>© 2026 Learn Punjabi Adventure. Designed following PlayStation UI/UX specifications. All rights reserved.</p>
    <div class="flex gap-4">
      <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
      <span>•</span>
      <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
      <span>•</span>
      <a href="#" class="hover:text-white transition-colors">Cookies Settings</a>
    </div>
  </div>
</footer>

<style>
  .footer-link-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
</style>
