---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "My Punjabi Heritage — Gurmukhi Language Learning Game", 
	description = "Embark on an interactive adventure map to learn Punjabi Gurmukhi. Collect trophies, rare pendants, and medals while exploring Punjabi-speaking communities worldwide!" 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Best Practices -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		
		<!-- Google Fonts for PlayStation SST Substitutes (Roboto Light & Inter) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto:wght@300;400;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-canvas-dark text-on-dark font-body antialiased min-h-screen flex flex-col">
		<slot />
	</body>
</html>
